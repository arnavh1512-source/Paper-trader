# Copy to .env and edit. Every value here is optional: leave a line out and the
# market profile's own default applies. Nothing in this file is a suggestion
# about what to trade or how much to risk -- those are your calls, and the
# defaults were chosen to be small and boring rather than good.
#
#   cp .env.example .env
#
# .env is gitignored. Never put a real key in .env.example.

# ---------------------------------------------------------------- the market
MARKET=in                  # in = NSE India, us = US equities
TRADE_SEGMENT=intraday     # intraday (squares off before close) | delivery

# ------------------------------------------------------------- YOUR CAPITAL
# The paper account's opening balance. Set it to whatever number makes the
# results mean something to you -- the whole point is that it is simulated.
STARTING_CASH=2000

# The hard ceiling on a single order. This is the number that actually decides
# how concentrated the book gets, more than any other setting here.
MAX_NOTIONAL_PER_TRADE=800

# The same cap as a fraction of equity. The tighter of the two wins.
MAX_POSITION_PCT=0.40

# Don't bother placing an order smaller than this -- on NSE, fixed statutory
# charges eat a ticket this small alive.
MIN_TRADE_NOTIONAL=100

# Fraction of equity that never gets deployed.
MIN_CASH_RESERVE_PCT=0.05

# ------------------------------------------------------------------ how many
MAX_POSITIONS=3
MAX_SECTOR_POSITIONS=1
MAX_TRADES_PER_CYCLE=3
MAX_TRADES_PER_DAY=10

# ---------------------------------------------------------------- how strict
# Decisions below this confidence never reach the broker. Raise it to trade
# less; lower it to trade more. `calibrate` tells you whether the number is
# doing anything at all -- until it says yes, treat it as arbitrary.
MIN_CONFIDENCE=7

# Stops and targets, in ATRs.
ATR_STOP_MULTIPLE=2.0
ATR_TARGET_MULTIPLE=3.0
TRAILING_STOP_ATR=2.5
HARD_STOP_PCT=0.08

# Bars a position may live before it is closed regardless of anything else.
MAX_HOLDING_BARS=23

# ------------------------------------------------------------ the breakers
# Both halt the run. The daily one resets tomorrow; the drawdown one does not
# until you clear it, which is deliberate.
DAILY_LOSS_LIMIT_PCT=0.03
MAX_DRAWDOWN_PCT=0.15

# ---------------------------------------------------------------- what to pick
# Comma separated. Leave unset to use the market's default universe.
#
# Leaving this unset is deliberate on a small book. NSE and BSE trade whole
# shares only, so on Rs 2,000 with a Rs 800 position cap most NIFTY names are
# out of reach today -- but the cap is a fraction of equity, so every rupee the
# account gains widens it, and a name becomes buyable the moment the book can
# afford it. Pinning the universe to today's affordable list would freeze that
# shut. `doctor` reports what is currently reachable.
# UNIVERSE=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# --------------------------------------------------------------------- news
# Off by default. When on, live cycles fetch recent headlines from public RSS
# (Google News plus a couple of market feeds) and show them to the model as
# clearly-labelled untrusted text. Headlines never reach the risk layer, and a
# feed being down never blocks a cycle or an exit.
#
# Backtests ignore this setting entirely: the feeds return today's headlines,
# and pricing a 2024 bar against a 2026 headline is not a backtest.
NEWS_ENABLED=true
NEWS_MAX_HEADLINES=5
NEWS_MAX_AGE_HOURS=24

# ------------------------------------------------------------------- engine
STRATEGY=claude            # claude | momentum (momentum is free and offline)

# Which Claude makes the calls. Sonnet 5 is the sensible default: a cycle can
# be dozens of decisions, and Opus costs more per call than the edge it is
# being tested for is worth until calibration says otherwise.
CLAUDE_MODEL=claude-sonnet-5   # or claude-opus-5 for the deepest reasoning
DRY_RUN=false              # true = decide and journal, send no orders
JOURNAL_PATH=data/journal.sqlite3

# ------------------------------------------------------------------ secrets
# NEVER commit real values. In GitHub Actions these belong in
# Settings -> Secrets and variables -> Actions, not here.
ANTHROPIC_API_KEY=
# US path only; the India path needs no broker key.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
